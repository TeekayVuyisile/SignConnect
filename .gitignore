# Dependencies
node_modules/

# Build output (Render rebuilds it with `npm run build`)
dist/
build/
*.tsbuildinfo
.vite/

# Local database (created at runtime; never commit user data)
server/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Secrets and environment config
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/

# Local AI/editor tooling (the ui-ux-pro-max skill lives here; it isn't part of the app)
.claude/
.vscode/
.idea/
*.swp
*.swo

# OS clutter
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Temporary files
tmp/
temp/
*.tmp
